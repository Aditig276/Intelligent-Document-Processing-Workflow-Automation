# ==============================================================================
# Intelligent Document Processing Workflow Automation
# Environment Configuration Template (.env.example)
#
# Copy this file to '.env' and adjust the values for your environment.
# Never commit actual secret keys or production passwords to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Django Settings
# ------------------------------------------------------------------------------
# Set to 'True' for local development; must be 'False' in production.
DJANGO_DEBUG=True

# Secret key for cryptographic signing and session encryption.
# In development, a fallback is provided if DJANGO_DEBUG=True.
# In production (DJANGO_DEBUG=False), this MUST be set to a secure, random string.
DJANGO_SECRET_KEY=django-insecure-change-this-to-a-secure-random-secret-key-in-production

# Comma-separated list of host/domain names that this Django site can serve.
# In development (DJANGO_DEBUG=True), defaults to 'localhost,127.0.0.1,[::1]'.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# By default, SQLite is used for local development and testing.
# To use SQLite with a custom path:
# SQLITE_DB_PATH=db.sqlite3

# To use PostgreSQL in production, provide a DATABASE_URL:
# DATABASE_URL=postgresql://user:password@localhost:5432/document_processing

# Alternatively, configure PostgreSQL with individual parameters:
# DB_ENGINE=postgresql
# DB_NAME=document_processing
# DB_USER=postgres
# DB_PASSWORD=your_secure_password
# DB_HOST=localhost
# DB_PORT=5432

# ------------------------------------------------------------------------------
# File Storage & Media Settings
# ------------------------------------------------------------------------------
# Directory paths for media and log files (optional, defaults to BASE_DIR/media and BASE_DIR/logs)
# MEDIA_ROOT=/path/to/media
# LOGS_DIR=/path/to/logs

# ------------------------------------------------------------------------------
# Upload Rate Limiting & Distributed Cache
# ------------------------------------------------------------------------------
# Controls rate limiting for document uploads (browser and REST API)
UPLOAD_RATE_LIMIT_ENABLED=True
UPLOAD_RATE_LIMIT_REQUESTS=100
UPLOAD_RATE_LIMIT_WINDOW=60

# Distributed Redis Cache (for production multi-instance rate limiting and caching)
# REDIS_URL=redis://localhost:6379/1

# ------------------------------------------------------------------------------
# Production HTTPS & Security Settings
# ------------------------------------------------------------------------------
# In production (DJANGO_DEBUG=False), configure SSL and cookie security:
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_ENABLED=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=False
# SECURE_TRUST_FORWARDED_FOR=False
